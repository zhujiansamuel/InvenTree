# InvenTree 本地开发环境变量配置
# 将此文件复制为 .env 使用

# ====================================
# 基本设置
# ====================================
INVENTREE_DEBUG=True
INVENTREE_LOG_LEVEL=DEBUG
INVENTREE_SITE_URL=http://localhost:8000

# ====================================
# 数据库配置 (Docker PostgreSQL)
# ====================================
INVENTREE_DB_ENGINE=postgresql
INVENTREE_DB_NAME=inventree
INVENTREE_DB_USER=inventree
INVENTREE_DB_PASSWORD=inventree123
INVENTREE_DB_HOST=localhost
INVENTREE_DB_PORT=5432

# ====================================
# Redis 缓存配置 (Docker Redis)
# ====================================
INVENTREE_CACHE_ENABLED=True
INVENTREE_CACHE_HOST=localhost
INVENTREE_CACHE_PORT=6379

# ====================================
# Django 设置
# ====================================
# 密钥（生产环境请更换）
INVENTREE_SECRET_KEY=your-secret-key-change-in-production
INVENTREE_ADMIN_ENABLED=True
INVENTREE_ADMIN_URL=admin

# ====================================
# 初始管理员账号（首次启动）
# ====================================
INVENTREE_ADMIN_USER=admin
INVENTREE_ADMIN_EMAIL=admin@inventree.local
INVENTREE_ADMIN_PASSWORD=admin123

# ====================================
# 插件和自动更新
# ====================================
INVENTREE_PLUGINS_ENABLED=True
INVENTREE_AUTO_UPDATE=True

# ====================================
# 邮件配置（开发环境使用控制台）
# ====================================
INVENTREE_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ====================================
# 跨域设置
# ====================================
INVENTREE_CORS_ALLOW_ALL=True

# ====================================
# 静态和媒体文件
# ====================================
INVENTREE_MEDIA_ROOT=./data/media
INVENTREE_STATIC_ROOT=./data/static
INVENTREE_BACKUP_DIR=./data/backup

# ====================================
# 语言和时区
# ====================================
INVENTREE_LANGUAGE=zh-cn
INVENTREE_TIMEZONE=Asia/Shanghai

# ====================================
# 后台任务设置
# ====================================
INVENTREE_BACKGROUND_WORKERS=4
INVENTREE_BACKGROUND_TIMEOUT=90

# ====================================
# 开发调试选项
# ====================================
INVENTREE_DEBUG_QUERYCOUNT=False
INVENTREE_DEBUG_SILK=False
INVENTREE_DB_LOGGING=False
INVENTREE_CONSOLE_LOG=True
INVENTREE_WRITE_LOG=False
